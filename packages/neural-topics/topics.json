{
  "version": "1.0.0",
  "topics": {
    "sensory.hearing.caption_stream": {
      "description": "听觉感知 — 字幕流控制与事件",
      "actor": {
        "actorId": "sensory-hearing",
        "runtime": "python",
        "system": "sensory",
        "module": "hearing"
      },
      "capabilities": [
        {
          "id": "sensory.hearing.caption_stream",
          "topic": "sensory.hearing.caption_stream.enable",
          "kinds": ["control"],
          "mode": "stream"
        },
        {
          "id": "sensory.hearing.caption_stream.stop",
          "topic": "sensory.hearing.caption_stream.disable",
          "kinds": ["control"],
          "mode": "once"
        },
        {
          "id": "sensory.hearing.caption_stream.asr_models",
          "topic": "sensory.hearing.caption_stream.asr_models",
          "kinds": ["query"],
          "mode": "once"
        }
      ],
      "subscribeTopics": ["sensory.hearing.caption_stream.*"],
      "subscribeKinds": ["control"],
      "actions": {
        "enable":     { "kind": "control", "direction": "body → python", "description": "启动字幕流" },
        "disable":    { "kind": "control", "direction": "body → python", "description": "停止字幕流" },
        "asr_models": { "kind": "query",   "direction": "body → nest → python (HTTP)", "description": "查询可用 ASR 模型列表" },
        "prepared":  { "kind": "event",   "direction": "python → subscribers", "description": "准备完成" },
        "started":   { "kind": "event",   "direction": "python → subscribers", "description": "录音已开始" },
        "vad_start": { "kind": "event",   "direction": "python → subscribers", "description": "VAD 检测到语音开始" },
        "vad_end":   { "kind": "event",   "direction": "python → subscribers", "description": "VAD 检测到语音结束" },
        "segment":   { "kind": "event",   "direction": "python → subscribers", "description": "字幕片段就绪" },
        "stopped":   { "kind": "event",   "direction": "python → subscribers", "description": "录音已停止" },
        "error":     { "kind": "event",   "direction": "python → subscribers", "description": "错误" }
      }
    },
    "sensory.speaking.voice": {
      "description": "语音合成 — 文字转语音控制与事件",
      "actor": {
        "actorId": "sensory-speaking",
        "runtime": "python",
        "system": "sensory",
        "module": "speaking"
      },
      "capabilities": [
        {
          "id": "sensory.speaking.voice",
          "topic": "sensory.speaking.voice.speak",
          "kinds": ["control"],
          "mode": "stream"
        },
        {
          "id": "sensory.speaking.voice.cancel",
          "topic": "sensory.speaking.voice.cancel",
          "kinds": ["control"],
          "mode": "once"
        },
        {
          "id": "sensory.speaking.voice.pause",
          "topic": "sensory.speaking.voice.pause",
          "kinds": ["control"],
          "mode": "once"
        },
        {
          "id": "sensory.speaking.voice.resume",
          "topic": "sensory.speaking.voice.resume",
          "kinds": ["control"],
          "mode": "once"
        },
        {
          "id": "sensory.speaking.voice.models",
          "topic": "sensory.speaking.voice.models",
          "kinds": ["query"],
          "mode": "once"
        },
        {
          "id": "sensory.speaking.voice.status",
          "topic": "sensory.speaking.voice.status",
          "kinds": ["query"],
          "mode": "once"
        }
      ],
      "subscribeTopics": ["sensory.speaking.voice.*"],
      "subscribeKinds": ["control"],
      "actions": {
        "speak":     { "kind": "control", "direction": "body → python", "description": "触发语音合成" },
        "cancel":    { "kind": "control", "direction": "body → python", "description": "取消播放" },
        "pause":     { "kind": "control", "direction": "body → python", "description": "暂停播放" },
        "resume":    { "kind": "control", "direction": "body → python", "description": "恢复播放" },
        "models":    { "kind": "query",   "direction": "body → nest → python (HTTP)", "description": "获取可用音色列表" },
        "status":    { "kind": "query",   "direction": "body → nest → python (HTTP)", "description": "获取 TTS 状态" },
        "started":   { "kind": "event",   "direction": "python → subscribers", "description": "开始播放" },
        "progress":  { "kind": "event",   "direction": "python → subscribers", "description": "播放进度" },
        "completed": { "kind": "event",   "direction": "python → subscribers", "description": "播放完成" },
        "error":     { "kind": "event",   "direction": "python → subscribers", "description": "错误" }
      }
    },
    "brain.init": {
      "description": "脑系统 — 系统初始化与健康检查",
      "actor": {
        "actorId": "brain-main",
        "runtime": "nest",
        "system": "brain",
        "module": "init"
      },
      "capabilities": [
        {
          "id": "brain.init",
          "topic": "brain.init.execute",
          "kinds": ["command"],
          "mode": "once"
        }
      ],
      "subscribeTopics": [],
      "subscribeKinds": [],
      "actions": {
        "execute":    { "kind": "command", "direction": "body → nest", "description": "执行系统初始化（检测/创建配置目录、检查依赖）" },
        "init_done":  { "kind": "event",   "direction": "nest → subscribers", "description": "初始化完成，返回检测结果" },
        "init_error": { "kind": "event",   "direction": "nest → subscribers", "description": "初始化失败" }
      }
    },
    "brain.cortex.chat": {
      "description": "脑系统 — 对话与响应生成",
      "actor": {
        "actorId": "brain-main",
        "runtime": "nest",
        "system": "brain",
        "module": "cortex"
      },
      "capabilities": [
        {
          "id": "brain.cortex.chat.complete",
          "topic": "brain.cortex.chat.complete",
          "kinds": ["command"],
          "mode": "once"
        },
        {
          "id": "brain.cortex.chat.stream",
          "topic": "brain.cortex.chat.stream",
          "kinds": ["command"],
          "mode": "stream"
        }
      ],
      "subscribeTopics": [],
      "subscribeKinds": [],
      "actions": {
        "complete": { "kind": "command", "direction": "body → nest", "description": "一次性生成对话响应" },
        "stream":   { "kind": "command", "direction": "body → nest", "description": "流式生成对话响应" }
      }
    },
    "brain.language.models": {
      "description": "脑系统 — 模型配置查询、校验与切换",
      "actor": {
        "actorId": "brain-main",
        "runtime": "nest",
        "system": "brain",
        "module": "language-center"
      },
      "capabilities": [
        {
          "id": "brain.language.models.list",
          "topic": "brain.language.models.list",
          "kinds": ["query"],
          "mode": "once"
        },
        {
          "id": "brain.language.models.validate",
          "topic": "brain.language.models.validate",
          "kinds": ["query"],
          "mode": "once"
        },
        {
          "id": "brain.language.model.switch",
          "topic": "brain.language.model.switch",
          "kinds": ["control"],
          "mode": "once"
        }
      ],
      "subscribeTopics": [],
      "subscribeKinds": [],
      "actions": {
        "list":     { "kind": "query", "direction": "body → nest", "description": "查询可用模型配置" },
        "validate": { "kind": "query", "direction": "body → nest", "description": "校验模型配置与环境依赖" },
        "switch":   { "kind": "control", "direction": "body → nest", "description": "切换当前生效模型 profile" }
      }
    },
    "brain.language.oauth": {
      "description": "脑系统 — OAuth Provider 查询与登录",
      "actor": {
        "actorId": "brain-main",
        "runtime": "nest",
        "system": "brain",
        "module": "cortex"
      },
      "capabilities": [
        {
          "id": "brain.language.oauth.providers",
          "topic": "brain.language.oauth.providers",
          "kinds": ["query"],
          "mode": "once"
        },
        {
          "id": "brain.language.oauth.login",
          "topic": "brain.language.oauth.login",
          "kinds": ["command"],
          "mode": "once"
        }
      ],
      "subscribeTopics": [],
      "subscribeKinds": [],
      "actions": {
        "providers": { "kind": "query", "direction": "body → nest", "description": "查询可用 OAuth provider 列表" },
        "login":     { "kind": "command", "direction": "body → nest", "description": "触发指定 provider 的 OAuth 登录流程" }
      }
    },
    "brain.agent": {
      "description": "脑系统 — Agent 执行与会话管理",
      "actor": {
        "actorId": "brain-main",
        "runtime": "nest",
        "system": "brain",
        "module": "agent"
      },
      "capabilities": [
        {
          "id": "brain.agent.run",
          "topic": "brain.agent.run",
          "kinds": ["command"],
          "mode": "stream"
        },
        {
          "id": "brain.agent.coding.run",
          "topic": "brain.agent.coding.run",
          "kinds": ["command"],
          "mode": "stream"
        },
        {
          "id": "brain.agent.session.get",
          "topic": "brain.agent.session.get",
          "kinds": ["query"],
          "mode": "once"
        },
        {
          "id": "brain.agent.session.list",
          "topic": "brain.agent.session.list",
          "kinds": ["query"],
          "mode": "once"
        }
      ],
      "subscribeTopics": [],
      "subscribeKinds": [],
      "actions": {
        "run":          { "kind": "command", "direction": "body → nest", "description": "执行 Agent 一轮推理与工具调用" },
        "coding_run":   { "kind": "command", "direction": "body → nest", "description": "执行 Coding Agent 工具链（read/bash/edit/write）" },
        "run_event":    { "kind": "event",   "direction": "nest → subscribers", "description": "Agent 运行过程事件流" },
        "session_get":  { "kind": "query",   "direction": "body → nest", "description": "读取指定会话详情" },
        "session_list": { "kind": "query",   "direction": "body → nest", "description": "读取会话列表" }
      }
    }
  }
}
