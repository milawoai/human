  "children": [
    {
      "id": "T0001",
      "type": "frame",
      "name": "主题规范",
      "children": [
        {
          "id": "T0002",
          "type": "frame",
          "name": "Header",
          "children": [
            {
              "id": "T0003",
              "type": "text",
              "name": "标题",
              "content": "Human 设计主题",
              "fontFamily": "$font-body",
              "fontSize": "$font-size-display",
              "fontWeight": "bold",
              "fill": "$text",
              "lineHeight": 1.2
            },
            {
              "id": "T0004",
              "type": "text",
              "name": "说明",
              "content": "所有页面共享这一套 token。切换 mode 轴即可比较内置主题，应用设置页使用同一套预设。",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "fontFamily": "$font-body",
              "fontSize": "$font-size-base",
              "fill": "$text-muted",
              "lineHeight": "$line-height"
            },
            {
              "id": "T0005",
              "type": "frame",
              "name": "Tokens",
              "children": [
                {
                  "id": "T0006",
                  "type": "frame",
                  "name": "Token 背景",
                  "children": [
                    {
                      "id": "T0007",
                      "type": "ellipse",
                      "name": "Dot",
                      "width": 8,
                      "height": 8,
                      "fill": "$bg"
                    },
                    {
                      "id": "T0008",
                      "type": "text",
                      "name": "Label",
                      "content": "背景",
                      "fontFamily": "$font-body",
                      "fontSize": "$font-size-xs",
                      "fill": "$text-muted"
                    }
                  ],
                  "gap": 6,
                  "alignItems": "center",
                  "padding": [
                    6,
                    10
                  ],
                  "cornerRadius": "$radius-sm",
                  "fill": "$surface-raised"
                },
                {
                  "id": "T0009",
                  "type": "frame",
                  "name": "Token 表面",
                  "children": [
                    {
                      "id": "T0010",
                      "type": "ellipse",
                      "name": "Dot",
                      "width": 8,
                      "height": 8,
                      "fill": "$surface"
                    },
                    {
                      "id": "T0011",
                      "type": "text",
                      "name": "Label",
                      "content": "表面",
                      "fontFamily": "$font-body",
                      "fontSize": "$font-size-xs",
                      "fill": "$text-muted"
                    }
                  ],
                  "gap": 6,
                  "alignItems": "center",
                  "padding": [
                    6,
                    10
                  ],
                  "cornerRadius": "$radius-sm",
                  "fill": "$surface-raised"
                },
                {
                  "id": "T0012",
                  "type": "frame",
                  "name": "Token 强调",
                  "children": [
                    {
                      "id": "T0013",
                      "type": "ellipse",
                      "name": "Dot",
                      "width": 8,
                      "height": 8,
                      "fill": "$accent"
                    },
                    {
                      "id": "T0014",
                      "type": "text",
                      "name": "Label",
                      "content": "强调",
                      "fontFamily": "$font-body",
                      "fontSize": "$font-size-xs",
                      "fill": "$text-muted"
                    }
                  ],
                  "gap": 6,
                  "alignItems": "center",
                  "padding": [
                    6,
                    10
                  ],
                  "cornerRadius": "$radius-sm",
                  "fill": "$surface-raised"
                }
              ],
              "gap": 8,
              "alignItems": "center"
            }
          ],
          "layout": "vertical",
          "gap": 10,
          "width": "fill_container"
        },
        {
          "id": "T0015",
          "type": "frame",
          "name": "颜色",
          "children": [
            {
              "id": "T0016",
              "type": "frame",
              "name": "颜色 Head",
              "children": [
                {
                  "id": "T0017",
                  "type": "text",
                  "name": "Title",
                  "content": "颜色 Color",
                  "fontFamily": "$font-body",
                  "fontSize": "$font-size-xl",
                  "fontWeight": "bold",
                  "fill": "$text"
                },
                {
                  "id": "T0018",
                  "type": "text",
                  "name": "Desc",
                  "content": "语义化命名：所有页面只引用 token 名，禁止写死颜色。",
                  "fontFamily": "$font-body",
                  "fontSize": "$font-size-sm",
                  "fill": "$text-subtle"
                }
              ],
              "layout": "vertical",
              "gap": 4,
              "width": "fill_container"
            },
            {
              "id": "T0019",
              "type": "frame",
              "name": "Row",
              "children": [
                {
                  "id": "T0020",
                  "type": "frame",
                  "name": "Swatch bg",
                  "children": [
                    {
                      "id": "T0021",
                      "type": "rectangle",
                      "name": "Color",
                      "width": "fill_container",
                      "height": 56,
                      "cornerRadius": "$radius-md",
                      "fill": "$bg",
                      "stroke": "$border",
                      "strokeWidth": 1,
                      "strokeAlignment": "inner"
                    },
                    {
                      "id": "T0022",
                      "type": "text",
                      "name": "Token",
                      "content": "bg",
                      "fontFamily": "$font-body",
                      "fontSize": "$font-size-xs",
                      "fontWeight": "bold",
                      "fill": "$text"
                    },
                    {
                      "id": "T0023",
                      "type": "text",
                      "name": "Usage",
                      "content": "页面最底层",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "fontFamily": "$font-body",
                      "fontSize": "$font-size-xs",
                      "fill": "$text-subtle"
                    }
                  ],
                  "layout": "vertical",
