{
  "version": 1,
  "defaultTheme": "harbor",
  "common": {
    "font-body": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif",
    "font-mono": "ui-monospace, \"SFMono-Regular\", Menlo, monospace",
    "line-height": "1.5",
    "radius-sm": "8px",
    "radius-md": "12px",
    "radius-lg": "16px",
    "spacing-1": "0.25rem",
    "spacing-2": "0.5rem",
    "spacing-3": "0.75rem",
    "spacing-4": "1rem",
    "spacing-5": "1.5rem",
    "spacing-6": "2rem",
    "spacing-7": "2.5rem",
    "spacing-8": "3rem",
    "pen-font-body": "Noto Sans SC",
    "pen-font-mono": "JetBrains Mono",
    "font-size-px": {
      "xs": 12,
      "sm": 14,
      "base": 16,
      "md": 17,
      "lg": 18,
      "xl": 21,
      "title": 25,
      "display": 32
    },
    "spacing-half": "0.125rem",
    "radius-control": "var(--human-radius-sm)",
    "radius-card": "var(--human-radius-md)",
    "radius-window": "var(--human-radius-lg)",
    "radius-pill": "999px",
    "radius-bubble-tail": "var(--human-spacing-half)",
    "space-page": "var(--human-spacing-6)",
    "space-section": "var(--human-spacing-5)",
    "space-card": "var(--human-spacing-5)",
    "space-panel": "var(--human-spacing-4)",
    "space-stack": "var(--human-spacing-4)",
    "space-related": "var(--human-spacing-2)",
    "space-control-x": "var(--human-spacing-3)",
    "space-control-y": "var(--human-spacing-2)",
    "space-compact-x": "var(--human-spacing-2)",
    "space-compact-y": "var(--human-spacing-1)"
  },
  "themes": {
    "dark": {
      "label": "深色",
      "tokens": {
        "bg": "#17191f",
        "surface": "#22252e",
        "surface-raised": "#2d313c",
        "surface-hover": "#353b48",
        "input": "#1c1f27",
        "text": "#edf0f7",
        "text-muted": "#b0b8c9",
        "text-subtle": "#8b96aa",
        "border": "#6B778C",
        "accent": "#9baeff",
        "accent-strong": "#4f63d8",
        "on-accent": "#ffffff",
        "accent-soft": "#303b64",
        "success": "#85dab0",
        "success-soft": "#1b3a31",
        "warning": "#efc47b",
        "warning-soft": "#3e3422",
        "danger": "#ff9da5",
        "danger-soft": "#44282f",
        "info": "#97c9ff",
        "info-soft": "#22394f",
        "shadow": "0 8px 28px #00000040",
        "scrim": "#00000066",
        "border-strong": "#8B97AD"
