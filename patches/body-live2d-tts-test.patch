+import assert from 'node:assert/strict'
+import { test } from 'node:test'
+// @ts-expect-error Node's strip-types runner requires the .ts extension.
+import { requestTtsSynthesis } from './tts.ts'
+
+test('discovers a ready TTS plugin and unwraps Neural plus ToolResult', async () => {
+  const calls: any[] = []
+  const result = await requestTtsSynthesis('  你好  ', async (request) => {
+    calls.push(request)
+    if (request.topic === 'motor.tool.list') {
+      return {
+        success: true,
+        data: {
+          tools: [
+            { id: 'offline', status: 'error', capabilities: ['tts.synthesize'] },
+            { id: 'external-tts', status: 'ready', capabilities: ['tts.synthesize'] }
+          ]
+        }
+      }
+    }
+    return {
+      success: true,
+      data: {
+        success: true,
+        data: {
+          audioUrl: 'http://127.0.0.1:12002/tts-cache/external-tts/test.wav'
+        }
+      }
+    }
+  })
+  assert.equal(result.audioUrl, 'http://127.0.0.1:12002/tts-cache/external-tts/test.wav')
+  assert.deepEqual(calls[0].payload, { category: 'tts', detailed: true })
+  assert.deepEqual(calls[1].payload, {
+    tool: 'external-tts',
+    capability: 'tts.synthesize',
+    parameters: { text: '你好', format: 'wav' }
+  })
+})
+
+test('rejects blank and overly long input before requesting the backend', async () => {
+  const trigger = async () => {
+    throw new Error('backend should not be called')
+  }
+  await assert.rejects(requestTtsSynthesis('  ', trigger), /请输入/)
+  await assert.rejects(requestTtsSynthesis('字'.repeat(2001), trigger), /2000/)
+})
+
+test('reports missing plugin and discovery errors', async () => {
+  await assert.rejects(
+    requestTtsSynthesis('你好', async () => ({ success: true, data: { tools: [] } })),
+    /没有可用/
+  )
+  await assert.rejects(
+    requestTtsSynthesis('你好', async () => ({ success: false, msg: '后端未就绪' })),
+    /后端未就绪/
+  )
+})
+
+test('preserves nested plugin errors and rejects invalid audio URLs', async () => {
+  for (const [response, pattern] of [
+    [
+      { success: false, data: { success: false, error: { message: '模型加载失败' } } },
+      /模型加载失败/
+    ],
+    [{ success: true, data: { success: false, error: { message: '合成失败' } } }, /合成失败/],
+    [{ success: true, data: { success: true, data: {} } }, /音频/],
+    [{ success: true, data: { success: true, data: { audioUrl: 'javascript:bad' } } }, /音频/]
+  ] as const) {
+    await assert.rejects(
+      requestTtsSynthesis('你好', async (request) =>
+        request.topic === 'motor.tool.list'
+          ? {
+              success: true,
+              data: { tools: [{ id: 'test', status: 'ready', capabilities: ['tts.synthesize'] }] }
+            }
+          : response
+      ),
+      pattern
+    )
+  }
+})
diff --git a/apps/body/src/main/services/live2d/tts.ts b/apps/body/src/main/services/live2d/tts.ts
new file mode 100644
index 0000000..dc898c2
--- /dev/null
+++ b/apps/body/src/main/services/live2d/tts.ts
@@ -0,0 +1,50 @@
+type NeuralRequest = { kind: string; topic: string; payload?: unknown }
+type NeuralTrigger = (request: NeuralRequest) => Promise<any>
+
+const errorMessage = (response: any, fallback: string): string =>
+  response?.data?.error?.message || response?.error?.message || response?.msg || fallback
+
+/** Discover through the category contract; no engine IDs or Python paths in Body. */
+export async function requestTtsSynthesis(
+  input: string,
+  trigger: NeuralTrigger
+): Promise<{ audioUrl: string }> {
+  const text = typeof input === 'string' ? input.trim() : ''
+  if (!text) throw new Error('请输入要播放的文本')
+  if (text.length > 2000) throw new Error('文本不能超过 2000 字')
+
+  const discovery = await trigger({
+    kind: 'query',
+    topic: 'motor.tool.list',
+    payload: { category: 'tts', detailed: true }
+  })
+  if (!discovery?.success) throw new Error(errorMessage(discovery, '查询语音插件失败'))
+  const tools = discovery.data?.tools
+  const tool =
+    Array.isArray(tools) &&
+    tools.find(
+      (item: any) =>
+        ['ready', 'running'].includes(item.status) && item.capabilities?.includes('tts.synthesize')
+    )
+  if (!tool) throw new Error('没有可用的语音插件，请先启用 TTS 插件')
+
+  const response = await trigger({
+    kind: 'command',
+    topic: 'motor.tool.execute',
+    payload: { tool: tool.id, capability: 'tts.synthesize', parameters: { text, format: 'wav' } }
+  })
+  if (!response?.success || !response.data?.success) {
+    throw new Error(errorMessage(response, '语音合成失败'))
+  }
+  const audioUrl = response.data.data?.audioUrl
+  let url: URL
+  try {
+    url = new URL(audioUrl)
+  } catch {
+    throw new Error('语音插件没有返回有效的音频地址')
+  }
+  if (!['http:', 'https:'].includes(url.protocol)) {
+    throw new Error('语音插件返回了不支持的音频地址')
+  }
+  return { audioUrl: url.href }
+}
