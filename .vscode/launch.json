{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "全栈：Electron渲染进程",
      "type": "chrome",
      "request": "attach",
      "port": 9222,
      "webRoot": "${workspaceFolder}/apps/body/src/renderer",
      "timeout": 180000,
      "presentation": {
        "hidden": true
      }
    },
    {
      "name": "全栈：Python（等待Neural注册）",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "main:app",
        "--host",
        "0.0.0.0",
        "--port",
        "12003",
        "--reload"
      ],
      "cwd": "${workspaceFolder}/apps/python-service",
      "preLaunchTask": "dev:wait-neural",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/apps/python-service/.env",
      "justMyCode": false,
      "python": "${workspaceFolder}/apps/python-service/.venv/bin/python",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/apps/python-service"
      },
      "presentation": {
        "hidden": true
      }
    },
    {
      "name": "全栈：Electron（等待Python注册）",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/apps/body",
      "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/electron-vite",
      "windows": {
        "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/electron-vite.cmd"
      },
      "runtimeArgs": [
        "dev",
        "--inspect=5858",
        "--sourcemap"
      ],
      "preLaunchTask": "dev:wait-hearing",
      "env": {
        "NODE_ENV": "development",
        "REMOTE_DEBUGGING_PORT": "9222"
      },
      "sourceMaps": true,
      "console": "integratedTerminal",
      "resolveSourceMapLocations": [
        "${workspaceFolder}/apps/body/**",
        "!**/node_modules/**"
      ],
      "presentation": {
        "hidden": true
      }
    },
    {
      "name": "调试后端",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "yarn",
      "runtimeArgs": [
        "workspace",
        "backend",
        "dev:debug"
      ],
      "cwd": "${workspaceFolder}",
      "restart": true,
      "preLaunchTask": "dev:kill-backend-port",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "env": {
        "NODE_ENV": "development"
      },
      "presentation": {
        "group": "开发调试",
        "order": 1
      }
    },
    {
      "name": "🖥️ 调试Electron主进程",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/apps/body",
      "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/electron-vite",
      "windows": {
        "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/electron-vite.cmd"
      },
      "runtimeArgs": [
        "dev",
        "--inspect=5858",
        "--sourcemap"
      ],
      "preLaunchTask": "dev:kill-electron-ports",
      "env": {
        "NODE_ENV": "development",
        "REMOTE_DEBUGGING_PORT": "9222"
      },
      "sourceMaps": true,
      "console": "integratedTerminal",
      "resolveSourceMapLocations": [
        "${workspaceFolder}/apps/body/**",
        "!**/node_modules/**"
      ],
      "presentation": {
        "hidden": true
      }
    },
    {
      "name": "🎨 调试Electron渲染进程",
      "type": "chrome",
      "request": "attach",
      "port": 9222,
      "webRoot": "${workspaceFolder}/apps/body/src/renderer",
      "timeout": 60000,
      "presentation": {
        "hidden": true
      }
    },
    {
      "name": "调试python服务",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "main:app",
        "--host",
        "0.0.0.0",
        "--port",
        "12003",
        "--reload"
      ],
      "cwd": "${workspaceFolder}/apps/python-service",
      "preLaunchTask": "dev:kill-python-port",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/apps/python-service/.env",
      "justMyCode": false,
      "python": "${workspaceFolder}/apps/python-service/.venv/bin/python",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/apps/python-service"
      },
      "presentation": {
        "group": "开发调试",
        "order": 2
      }
    }
  ],
  "compounds": [
    {
      "name": "全部启动",
      "preLaunchTask": "dev:cleanup-all",
      "configurations": [
        "调试后端",
        "全栈：Python（等待Neural注册）",
        "全栈：Electron（等待Python注册）",
        "全栈：Electron渲染进程"
      ],
      "stopAll": true,
      "presentation": {
        "group": "开发调试",
        "order": 4
      }
    },
    {
      "name": "调试 Electron",
      "preLaunchTask": "dev:kill-electron-ports",
      "configurations": [
        "🖥️ 调试Electron主进程",
        "🎨 调试Electron渲染进程"
      ],
      "stopAll": true,
      "presentation": {
        "group": "开发调试",
        "order": 3
      }
    }
  ]
}
