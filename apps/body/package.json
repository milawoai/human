{
  "name": "electron_with_serve",
  "version": "1.0.0",
  "description": "电子人-身体系统",
  "main": "./out/main/index.js",
  "author": "example.com",
  "homepage": "https://electron-vite.org",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "node ../../scripts/verify-theme-usage.cjs && vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "yarn typecheck:node && yarn typecheck:web",
    "test:tts": "node --experimental-strip-types --test src/main/services/live2d/tts.test.ts",
    "test:speech": "node --experimental-strip-types --test src/shared/session-speech.test.ts src/shared/speech-playback.test.ts",
    "test:agent": "node --experimental-strip-types --test src/shared/agent-panel.test.ts src/main/services/agent/bridge.test.ts",
    "start": "yarn electron-vite preview",
    "dev": "yarn electron-vite dev",
    "build": "yarn typecheck && yarn electron-vite build",
    "build:no-lint": "node ../../scripts/verify-theme-usage.cjs && yarn electron-vite build",
    "clean": "rm -rf out dist build",
    "postinstall": "echo 'Skipping electron-builder install-app-deps in monorepo setup'",
    "build:unpack": "yarn build:no-lint && yarn node scripts/copy-services.js && yarn electron-builder --dir",
    "build:win": "yarn build:no-lint && yarn node scripts/copy-services.js && yarn electron-builder --win",
    "build:mac": "yarn build:no-lint && yarn node scripts/copy-services.js && yarn electron-builder --mac",
    "build:linux": "yarn build:no-lint && yarn node scripts/copy-services.js && yarn electron-builder --linux",
    "copy-services": "yarn node scripts/copy-services.js",
    "prebuild": "echo '准备构建...'",
    "postbuild": "echo '构建完成!'",
    "build:electron": "turbo run build:electron --filter=electron-app && yarn copy-services && yarn electron-builder",
    "test:theme": "node --experimental-strip-types --test src/main/services/theme/*.test.ts src/shared/theme*.test.ts",
    "test:startup": "node --experimental-strip-types --test src/main/services/startup/*.test.ts",
    "test:backend-lifecycle": "node --experimental-strip-types --test src/main/services/backend-lifecycle/*.test.ts"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^4.0.0",
    "@logicflow/core": "^2.2.5",
    "@logicflow/extension": "^2.3.1",
    "@primeuix/themes": "^1.2.5",
    "@tailwindcss/vite": "^4.3.3",
    "@tdesign-vue-next/chat": "^0.3.0",
    "axios": "^1.20.0",
    "editorconfig": "^3.0.0",
    "electron-store": "8.2.0",
    "express": "^5.3.0",
    "kill-port": "^2.0.1",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.5",
    "socket.io-client": "^4.8.4",
    "tailwindcss-primeui": "^0.6.1",
    "toml": "^3.0.0",
    "uuid": "^13.0.2",
    "volta": "^0.0.0",
    "vue-i18n": "^11.4.14",
    "vue-router": "^4.6.4",
    "ws": "^8.22.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@primevue/auto-import-resolver": "^4.5.5",
    "@rushstack/eslint-patch": "^1.11.0",
    "@types/electron-store": "^3.2.2",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^5.2.4",
    "electron": "^34.5.8",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^9.33.0",
    "less": "^4.9.1",
    "less-loader": "^12.3.3",
    "postcss": "^8.5.30",
    "prettier": "^3.9.10",
    "sass": "1.62.1",
    "tailwindcss": "3.4.16",
    "typescript": "^5.9.3",
    "unplugin-auto-import": "^0.17.8",
    "unplugin-vue-components": "^28.8.0",
    "vite": "^6.4.4",
    "vite-plugin-commonjs": "^0.10.4",
    "vue": "^3.5.44",
    "vue-tsc": "^2.2.12"
  },
  "volta": {
    "node": "22.19.0"
  }
}
