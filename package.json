{
  "name": "human-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Human monorepo: Electron + NestJS + Python",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "clean": "turbo run clean",
    "start:backend": "yarn workspace backend start:dev",
    "start:electron": "yarn workspace electron_with_serve dev",
    "build:backend": "yarn workspace backend build",
    "build:electron": "yarn workspace electron_with_serve build"
  },
  "workspaces": [
    "apps/*"
  ],
  "devDependencies": {
    "turbo": "^2.5.6"
  },
  "packageManager": "yarn@1.22.0",
  "engines": {
    "node": ">=18.0.0"
  }
}
