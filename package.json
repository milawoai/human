{
  "name": "human-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Human monorepo: Electron + NestJS + Python",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "clean": "turbo run clean",
    "start:backend": "yarn workspace backend start:dev",
    "start:electron": "yarn workspace electron_with_serve dev",
    "build:backend": "yarn workspace backend build",
    "build:electron": "yarn workspace electron_with_serve build",
    "verify:process-boundaries": "node scripts/verify-product-process-boundaries.cjs",
    "verify:desktop-lifecycle": "yarn verify:process-boundaries && node scripts/verify-neural-connection.cjs && node scripts/verify-desktop-lifecycle.cjs",
    "verify:startup-window": "yarn workspace electron_with_serve build:no-lint && yarn workspace electron_with_serve test:startup && node scripts/verify-startup-window.cjs",
    "verify:theme-usage": "node scripts/verify-theme-usage.cjs",
    "theme:test-usage": "node --test scripts/theme/usage.test.cjs",
    "theme:prune-baseline": "node scripts/verify-theme-usage.cjs --prune-baseline",
    "verify:theme": "yarn workspace electron_with_serve build:no-lint && yarn workspace electron_with_serve test:theme && node scripts/theme/check-contrast.mjs && node scripts/theme/export-presets.mjs --check && node scripts/verify-theme.cjs",
    "verify:desktop-electron": "yarn verify:process-boundaries && node scripts/verify-desktop-electron.cjs",
    "theme:export-presets": "node scripts/theme/export-presets.mjs",
    "theme:sync": "node scripts/theme/sync-theme.mjs",
    "theme:test-sync": "node --test scripts/theme/sync-theme.test.mjs",
    "theme:build": "node scripts/theme/build-theme-pen.mjs",
    "theme:check": "node scripts/theme/check-contrast.mjs",
    "theme:use": "node scripts/theme/use-theme.mjs",
    "theme:test-use": "node --test scripts/theme/use-theme.test.mjs"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/*/*"
  ],
  "devDependencies": {
    "turbo": "^2.11.8"
  },
  "packageManager": "yarn@1.22.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "mysql2": "^3.24.6"
  }
}
